+    // Registration, notification, and removal all hold m_mutex. The caller retains
+    // the tasks until this stack-owned waiter is removed, including waitAny losers.
+    class scoped_task_waiter {
+        task_manager & m_manager;
+        lean_task_object * m_task;
+        object * m_task_list;
+        condition_variable m_cv;
+
+        void remove(lean_task_object * task) {
+            auto range = m_manager.m_task_waiters.equal_range(task);
+            for (auto it = range.first; it != range.second;) {
+                if (it->second == &m_cv)
+                    it = m_manager.m_task_waiters.erase(it);
+                else
+                    ++it;
+            }
+        }
+
+    public:
+        scoped_task_waiter(task_manager & manager):
+            m_manager(manager), m_task(nullptr), m_task_list(nullptr) {}
+
+        void watch(lean_task_object * task) {
+            m_task = task;
+            m_manager.m_task_waiters.emplace(task, &m_cv);
+        }
+
+        void watch(object * task_list) {
+            m_task_list = task_list;
+            for (object * it = task_list; !is_scalar(it); it = cnstr_get(it, 1))
+                m_manager.m_task_waiters.emplace(lean_to_task(cnstr_get(it, 0)), &m_cv);
+        }
+
+        scoped_task_waiter(scoped_task_waiter const &) = delete;
+        scoped_task_waiter & operator=(scoped_task_waiter const &) = delete;
+
+        ~scoped_task_waiter() {
+            if (m_task) {
+                remove(m_task);
+            } else if (m_task_list) {
+                for (object * it = m_task_list; !is_scalar(it); it = cnstr_get(it, 1))
+                    remove(lean_to_task(cnstr_get(it, 0)));
+            }
+        }
+
+        void wait(unique_lock<mutex> & lock) { m_cv.wait(lock); }
+    };

